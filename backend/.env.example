NODE_ENV=development
PORT=4000

# ─── Supabase / PostgreSQL ────────────────────────────────────────────────────
# Encontrás estas URLs en: Supabase → tu proyecto → Settings → Database
#
# DATABASE_URL  → "Transaction pooler" (puerto 6543) — para queries en producción
# DIRECT_URL    → "Direct connection"  (puerto 5432) — para migraciones con Prisma
#
# Ejemplo:
# DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres.ikgbxehflpvszqfepxym:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgrespgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_segura_de_32_caracteres
JWT_REFRESH_SECRET=cambia_esto_por_otra_clave_segura_distinta
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe (podés dejarlo vacío hasta que quieras integrar pagos) ────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ─── SendGrid (podés dejarlo vacío hasta que quieras emails) ─────────────────
SENDGRID_API_KEY=SG.
SENDGRID_FROM_EMAIL=noreply@tudominio.com

# ─── URLs ────────────────────────────────────────────────────────────────────
# En desarrollo local:
FRONTEND_URL=http://localhost:3000
# En producción (Railway), reemplazá con tu URL de Vercel:
# FRONTEND_URL=https://tu-app.vercel.app

# ─── Scraping ────────────────────────────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=12
# Lista de proxies separados por coma (opcional, para evitar bloqueos):
# PROXY_LIST=ip1:puerto,ip2:puerto
PROXY_LIST=
